# 复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交。
#
# 下列变量是【当前代码实际读取】的；服务端通过 dotenv 在运行时自动加载本文件。
# （原 AI Studio 模板中的 GEMINI_API_KEY / APP_URL 当前代码并未使用，故未列出。）

# ---- 运行时配置（服务端读取）----
NODE_ENV=production
PORT=5188

# ---- 安全（生产必须修改）----
# 相册管理员密码（代码默认 "krabi2026"，务必改掉）。GALLERY_ADMIN_PASSWORD 优先于 ADMIN_PASSWORD。
GALLERY_ADMIN_PASSWORD=change-me-to-a-strong-password
# 管理员会话 Cookie 的签名密钥（代码默认 "default_krabi_2026_salt_secret"，不安全，务必改）。
# 生成：openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-openssl-rand-hex-32

# ---- 第三方数据源（可选，服务端读取）----
# WorldTides API key；不填则潮汐使用内置模拟数据。天气用免 key 的 Open-Meteo，无需配置。
# WORLD_TIDES_API_KEY=

# ---- 缓存 / 超时（可选，均有默认值）----
# WEATHER_CACHE_TTL_MINUTES=10
# TIDE_CACHE_TTL_MINUTES=360
# API_TIMEOUT_MS=8000

# ---- 地图（可选，【构建期】变量，不是运行时变量）----
# 用于"新增打卡点"页的真实 Google 地图；不填会回退到本地模拟地图盘。
# 注意：它由 vite.config.ts 在 build 时直接从 shell 环境读取，.env 文件不会自动生效。
# 需在构建前导出到 shell：  export GOOGLE_MAPS_PLATFORM_KEY="xxx" && npm run build
# GOOGLE_MAPS_PLATFORM_KEY=
